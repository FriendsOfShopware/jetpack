{% block jetpack_banner %}
<section
    v-bind="$attrs"
    class="jetpack-banner"
    :class="`jetpack-banner--${variant}`"
    :role="variant === 'critical' ? 'alert' : 'status'"
>
    <jetpack-icon
        :name="iconName"
        :decorative="false"
        :label="variant"
    />
    <div class="jetpack-banner__content">
        <strong
            v-if="title"
            class="jetpack-banner__title"
        >{{ title }}</strong>
        <div class="jetpack-banner__message">
            <slot>{{ message }}</slot>
        </div>
        <div
            v-if="$slots.actions"
            class="jetpack-banner__actions"
        ><slot name="actions"></slot></div>
    </div>
    <button
        v-if="dismissible"
        class="jetpack-banner__dismiss"
        type="button"
        aria-label="Dismiss"
        @click="$emit('dismiss')"
    ><jetpack-icon name="close" /></button>
</section>
{% endblock %}
