{% block jetpack_inheritance_control %}
<div
    class="jetpack-inheritance-control"
    :class="{ 'jetpack-inheritance-control--inherited': inherited }"
>
    <div class="jetpack-inheritance-control__header">
        <span class="jetpack-inheritance-control__label">{{ label }}</span>
        <jetpack-button
            variant="tertiary"
            size="small"
            :disabled="disabled"
            @click="$emit('update:inherited', !inherited)"
        >{{ inherited ? overwriteLabel : inheritLabel }}</jetpack-button>
    </div>
    <div
        class="jetpack-inheritance-control__content"
        :aria-disabled="inherited || undefined"
    >
        <slot :inherited="inherited"></slot>
    </div>
</div>
{% endblock %}
